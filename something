local function formatFruitName(name)
    local raw = tostring(name or "Fruit")
    for index = 2, #raw - 1 do
        if raw:sub(index, index) == "-" then
            local left, right = raw:sub(1, index - 1), raw:sub(index + 1)
            if string.lower(left) == string.lower(right) then return left end
        end
    end
    return raw:gsub("%-", " ")
end

local function normalizeFruitName(name)
    local raw = formatFruitName(name)
    raw = raw:gsub(" Fruit$", "")
    raw = raw:gsub("%-", " ")
    raw = raw:gsub("%s+", " ")
    return string.lower(raw:match("^%s*(.-)%s*$") or raw)
end

local function fruitWanted(fruit)
    local list = Settings.AutoFruitList
    if not list or #list == 0 then return true end
    if not fruit or not fruit.Name then return true end
    local base = normalizeFruitName(fruit.Name)
    for _, selected in ipairs(list) do
        if normalizeFruitName(selected) == base then return true end
    end
    return false
end

state.QueueFruitStore = function(source, fallbackName)
    local sourceName = source and source.Name or fallbackName or "Fruit"
    local wantedName = normalizeFruitName(sourceName)
    local displayName = formatFruitName(sourceName):gsub("%s+[Ff]ruit$", "")
    task.spawn(function()
        local tool
        local deadline = os.clock() + 6
        while state.Alive and os.clock() < deadline and not tool do
            for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
                if container then
                    for _, candidate in ipairs(container:GetChildren()) do
                        if candidate:IsA("Tool") and physicalFruit(candidate)
                            and normalizeFruitName(candidate.Name) == wantedName then
                            tool = candidate
                            break
                        end
                    end
                end
                if tool then break end
            end
            if not tool then task.wait(0.1) end
        end
        if not tool then
            if state.Alive then showNotice("Picked up " .. displayName .. "; storage tool not found", Red, 4) end
            return
        end

        local keys, seen = {}, {}
        local function addKey(value)
            value = tostring(value or "")
            if value ~= "" and not seen[value] then
                seen[value] = true
                keys[#keys + 1] = value
            end
        end
        addKey(tool:GetAttribute("OriginalName"))
        addKey(tool:GetAttribute("FruitName"))
        addKey(tool.Name)
        local baseName = tool.Name:gsub("%s+[Ff]ruit$", "")
        addKey(baseName .. "-" .. baseName)

        for _, key in ipairs(keys) do
            pcall(function() CommF:InvokeServer("StoreFruit", key, tool) end)
            local waitUntil = os.clock() + 0.45
            repeat task.wait(0.05) until not tool.Parent or os.clock() >= waitUntil
            if not tool.Parent or not tool:IsDescendantOf(LocalPlayer) then
                if state.Alive then showNotice("Stored " .. displayName, espColor(Settings.FruitColor), 3) end
                return
            end
        end
        if state.Alive then showNotice("Could not store " .. displayName, Red, 4) end
    end)
end

