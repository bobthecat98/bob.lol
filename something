connect(RunService.Heartbeat, function(deltaTime)
    if not state.Alive then return end
    local _, _, root = getCharacter(LocalPlayer)
    if root then
        state.FarmPaused = false
        FarmRuntime.Update(root)
        if state.TravelTarget and (state.TravelMode == "farmEnemy" or state.TravelMode == "farmBoss") and not autoTravelObjectValid() then
            stopTravel()
        end
        if state.TravelTarget then
            local offset = state.TravelTarget - root.Position
            local distance = offset.Magnitude
            if distance <= 1 then
                local mode = state.TravelMode
                root.CFrame = CFrame.new(state.TravelTarget) * (root.CFrame - root.Position)
                if mode == "farmEnemy" or mode == "farmBoss" then
                    root.AssemblyLinearVelocity = Vector3.zero
                else
                    stopTravel()
                end
            else
                root.AssemblyLinearVelocity = Vector3.zero
                moveInOneStudSteps(root, offset.Unit, Settings.FarmTravelSpeed, deltaTime, "TravelBudget", distance)
            end
        end
    elseif state.TravelTarget then
        stopTravel()
    end
end)
