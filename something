local function formatMoney(value)
    local text = tostring(math.max(0, math.floor(tonumber(value) or 0)))
    local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return "$" .. formatted:gsub("^,", "")
end

