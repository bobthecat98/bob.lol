local function getIslandNames()
    local priority, seen = {}, {}
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local locations = origin and origin:FindFirstChild("Locations")
    if locations then
        for _, instance in ipairs(locations:GetChildren()) do
            if instance:IsA("BasePart") and instance.Name ~= "Sea" then
                local display = tostring(instance:GetAttribute("DisplayName") or instance.Name)
                if not seen[display] then
                    seen[display] = true
                    priority[#priority + 1] = display
                end
            end
        end
    end
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, island in ipairs(map:GetChildren()) do
            if island:IsA("Model") and (#island:GetDescendants() > 20 or #island:GetChildren() > 0) and not seen[island.Name] then
                seen[island.Name] = true
                priority[#priority + 1] = island.Name
            end
        end
    end
    table.sort(priority)
    if #priority == 0 then priority[1] = "Unavailable" end
    return priority
end

